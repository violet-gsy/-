<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.mapper.TInterfaceMapper">

    <resultMap id="BaseResultMap" type="com.jc.entity.TInterface">
            <id property="id" column="ID" jdbcType="CHAR"/>
            <result property="name" column="NAME" jdbcType="VARCHAR"/>
            <result property="type" column="TYPE" jdbcType="VARCHAR"/>
            <result property="connector" column="CONNECTOR" jdbcType="VARCHAR"/>
            <result property="connected" column="CONNECTED" jdbcType="VARCHAR"/>
            <result property="status" column="STATUS" jdbcType="VARCHAR"/>
            <result property="remark" column="REMARK" jdbcType="VARCHAR"/>
            <result property="createtime" column="CREATETIME" jdbcType="TIMESTAMP"/>
            <result property="subsystem" column="SUBSYSTEM" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID,NAME,TYPE,
        CONNECTOR,CONNECTED,STATUS,
        REMARK,CREATETIME,SUBSYSTEM
    </sql>
</mapper>
