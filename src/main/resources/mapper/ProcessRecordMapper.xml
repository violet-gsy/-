<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.mapper.ProcessRecordMapper">

    <resultMap id="BaseResultMap" type="com.jc.entity.ProcessRecord">
            <id property="recordid" column="RECORDID" jdbcType="CHAR"/>
            <result property="processid" column="PROCESSID" jdbcType="CHAR"/>
            <result property="processprog" column="PROCESSPROG" jdbcType="NUMERIC"/>
            <result property="issuccess" column="ISSUCCESS" jdbcType="NUMERIC"/>
            <result property="starttime" column="STARTTIME" jdbcType="TIMESTAMP"/>
            <result property="endtime" column="ENDTIME" jdbcType="TIMESTAMP"/>
            <result property="totaltime" column="TOTALTIME" jdbcType="OTHER"/>
            <result property="fault" column="FAULT" jdbcType="VARCHAR"/>
            <result property="isexpect" column="ISEXPECT" jdbcType="INTEGER"/>
            <result property="procInstId" column="PROC_INST_ID_" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        RECORDID,PROCESSID,PROCESSPROG,
        ISSUCCESS,STARTTIME,ENDTIME,
        TOTALTIME,FAULT,ISEXPECT,
        PROC_INST_ID_
    </sql>
</mapper>
